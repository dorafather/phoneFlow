# ============================================================
# phoneFlow .gitignore
# ============================================================

# ---- Android/Gradle 표준 ----
*.iml
.gradle/
/local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/
app/build/
app/.cxx/
*.apk
*.ap_
*.aab
*.dex
*.class

# ---- 서명 키스토어/비밀번호 (저장소 바깥에 따로 보관 - 커밋 금지) ----
*.jks
*.keystore
keystore.properties

# ---- 구 레이아웃(ndk-build 스타일, CMake 표준 레이아웃으로 이전 완료 -
# app/src/main/cpp/에 동일 소스가 이미 있음. 로컬 참고용으로만 보존) ----
/jni/

# ---- Windows 전용 프리빌트 OpenSSL 라이브러리 (CMake 빌드가 쓰지 않음,
# libUtil을 Windows NotebookFlow에서 그대로 복사해 온 과정에서 같이
# 따라온 77MB짜리 바이너리 - Android 빌드에 불필요) ----
app/src/main/cpp/libUtil/openssl-win/

# ---- 로그 ----
*.log

# ---- 로컬 에이전트 메모리(이 저장소 공개 범위 밖, 내부 작업 기록) ----
/.claude/

# ---- 시나리오 파싱 디버그 덤프(개발 중 생성된 임시 산출물, NotebookFlow
# 원본 전체 scenario 구조가 그대로 들어있어 phoneFlow 범위 밖) ----
/rest_config_check.json
